# ===============================
# GoMuter Backend Environment
# Copy to .env for local use.
# In Render production, set these as service environment variables.
# ===============================

# Core
DEBUG=True
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=127.0.0.1,localhost,.onrender.com
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://*.onrender.com
CORS_ALLOWED_ORIGINS=http://127.0.0.1:59891,http://localhost:59891
CORS_ALLOW_ALL_ORIGINS_DEV=True

# Database (Option A: single URL, recommended for production)
# Example Supabase:
# DATABASE_URL=postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=

# Database (Option B: separate fields for local dev)
DB_NAME=gomuter_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=require
DB_CONN_MAX_AGE=600

# API throttling
DRF_THROTTLE_ANON=60/min
DRF_THROTTLE_USER=300/min

# Security when DEBUG=False
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Email (optional)
GOMUTER_EMAIL_HOST_USER=
GOMUTER_EMAIL_HOST_PASSWORD=
GOMUTER_EMAIL_HOST=smtp.gmail.com
GOMUTER_EMAIL_PORT=587
GOMUTER_EMAIL_USE_TLS=true
GOMUTER_DEFAULT_FROM_EMAIL=no-reply@gomuter.local
