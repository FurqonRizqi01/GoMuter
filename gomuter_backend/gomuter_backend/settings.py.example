# This file documents expected environment variables for settings.py.
# Keep secrets in env vars (or .env locally), never hardcode credentials.

# Core
# DEBUG=False
# SECRET_KEY=replace-with-a-long-random-secret
# ALLOWED_HOSTS=api.example.com
# CSRF_TRUSTED_ORIGINS=https://api.example.com
# CORS_ALLOWED_ORIGINS=https://app.example.com

# Database (preferred in production)
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# Optional overrides when DATABASE_URL is not set:
# DB_NAME=gomuter_db
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_SSLMODE=require
# DB_CONN_MAX_AGE=600

# API rate limits
# DRF_THROTTLE_ANON=60/min
# DRF_THROTTLE_USER=300/min

# Security (production defaults are enabled when DEBUG=False)
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True

# Email (password reset)
# GOMUTER_EMAIL_HOST_USER=you@example.com
# GOMUTER_EMAIL_HOST_PASSWORD=app-password
# GOMUTER_EMAIL_HOST=smtp.gmail.com
# GOMUTER_EMAIL_PORT=587
# GOMUTER_EMAIL_USE_TLS=true
# GOMUTER_DEFAULT_FROM_EMAIL=no-reply@example.com

# Firebase
# Place service account file at: gomuter_backend/serviceAccountKey.json
